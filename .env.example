# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true on the production custom domain. Preview deployments stay noindex.
ALLOW_INDEXING=false

# Postgres. Vercel Postgres / Neon may set POSTGRES_URL instead. Either works.
DATABASE_URL=postgres://chateaux:chateaux@127.0.0.1:5432/chateaux
POSTGRES_URL=postgres://chateaux:chateaux@127.0.0.1:5432/chateaux

# Payload. Use a long random string in every environment.
PAYLOAD_SECRET=replace-with-a-long-random-string
PREVIEW_SECRET=replace-with-another-long-random-string

# First admin, created on boot only when the users collection is empty.
# You can also open /admin and create the first user in the browser if these are blank.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Media. Leave blank locally to store uploads in /media. On Vercel, connect Blob storage.
BLOB_READ_WRITE_TOKEN=

# Email. If RESEND_API_KEY is missing, messages are logged and the app still works.
RESEND_API_KEY=
RESEND_FROM=Chateaux Rouge <notifications@example.com>
NOTIFY_EMAIL=owner@example.com

# Calendly. Full https://calendly.com/... links. Blank shows a clearly marked placeholder.
CALENDLY_STRATEGY_URL=
CALENDLY_FIT_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=

# Cron for partial-lead and unbooked reminders, and scheduled publish.
CRON_SECRET=replace-with-a-long-random-string

# PostHog. Client events wait for the consent banner. Server events respect the same flag.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
