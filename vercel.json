{
  "regions": ["syd1"],
  "redirects": [
    {
      "source": "/:path((?!api/cron)(?!api/webhooks).*)",
      "has": [
        {
          "type": "host",
          "value": "^chateaux-rouge\\.vercel\\.app$"
        }
      ],
      "destination": "https://chateauxrouge.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/abandonment",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "0 1 * * *"
    }
  ]
}
