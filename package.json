{
  "name": "chateaux-rouge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chateaux Rouge marketing site, journal, and application funnel.",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "node scripts/migrate-if-configured.mjs && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/scoring.test.ts src/lib/funnel-analytics.test.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation node --env-file=.env --import tsx src/seed/run.ts"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "cross-env": "^10.1.0",
    "graphql": "^16.11.0",
    "next": "16.4.2",
    "payload": "3.93.0",
    "posthog-js": "^1.304.0",
    "posthog-node": "^5.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.4.2",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
